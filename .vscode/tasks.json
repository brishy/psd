{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Tests", 
            "type": "shell",
            "command": "make", 
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Builds the test executable using Makefile"
        },
        {
            "label": "Run Tests", 
            "type": "shell",
            "command": "make test", 
            "group": "test",
            "dependsOn": ["Build Tests"], 
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            },
            "problemMatcher": [], 
            "detail": "Runs the test suite using 'make test'"
        },
         {
            "label": "Build App", 
            "type": "shell",
            "command": "make main",
            "group": "build",
            "problemMatcher": ["$gcc"],
            "detail": "Builds the main application executable using 'make main'"
        },
        {
            "label": "Run App", 
            "type": "shell",
            "command": "./main", 
            "dependsOn": ["Build App"], 
             "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true, 
                "panel": "dedicated", 
                "showReuseMessage": false,
                "clear": true 
            },
            "problemMatcher": [],
            "detail": "Runs the main application './main'"
        },
        {
            "label": "Clean", 
            "type": "shell",
            "command": "make clean",
            "group": "build",
            "problemMatcher": [],
            "detail": "Removes build artifacts using 'make clean'"
        }
    ]
}